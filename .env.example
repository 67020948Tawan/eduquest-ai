# ==============================================================================
# EduQuest AI — Environment Configuration
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ
# ⚠️ ห้าม commit .env (ที่มี key จริง) ลง git เด็ดขาด
# ==============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eduquest_db
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/eduquest_db

# Security — generate ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider — DeepSeek (บังคับใช้ key นี้)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=300

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
